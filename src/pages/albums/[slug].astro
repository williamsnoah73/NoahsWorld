---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import { resolvePublicImage } from '../../lib/media';

export function getStaticPaths() {
  const albumModules = import.meta.glob('../../content/albums/legacy/**/*.json', { eager: true });
  const albumEntries = Object.values(albumModules).map((mod) => (mod as any).default ?? mod);
  return albumEntries
    .filter((entry) => entry?.privacy === 'public')
    .map((entry) => ({ params: { slug: entry.slug } }));
}

const albumModules = import.meta.glob('../../content/albums/legacy/**/*.json', { eager: true });
const albumEntries = Object.values(albumModules).map((mod) => (mod as any).default ?? mod);
const { slug } = Astro.params;
const album = albumEntries.find((entry) => entry.slug === slug && entry.privacy === 'public');

if (!album) {
  throw new Error(`Album not found for slug: ${slug}`);
}

const galleryImages = (album.images ?? []).map((image: any, index: number) => ({
  src: resolvePublicImage(image.asset),
  alt: image.caption || `${album.title}, photograph ${index + 1} of ${album.images.length}`,
  caption: image.caption,
}));
---

<BaseLayout title={album.title} description={album.summary || 'A photo album from Noah\'s World.'} image={resolvePublicImage(album.featuredImage)?.src}>
  <article class="prose">
    <p class="eyebrow">{album.section}</p>
    <h1>{album.title}</h1>
    <div class="meta">
      {album.date && <time>{new Date(album.date).toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}</time>}
      <span>{album.privacy}</span>
    </div>
    <p class="lede">{album.summary}</p>
  </article>
  {galleryImages.length > 0 && <Gallery images={galleryImages} />}
</BaseLayout>
